# لا ترفع ملف secrets.toml الحقيقي إلى GitHub.

[contact_email]
smtp_host = "smtp.gmail.com"
smtp_port = 465
username = "techn47@gmail.com"
sender_email = "techn47@gmail.com"
app_password = "ضع-هنا-كلمة-مرور-تطبيق-Gmail"

[admin]
password = "ضع-هنا-كلمة-مرور-الأدمن"

[gsheets]
spreadsheet = "ضع-هنا-رابط-أو-معرف-جدول-Google"
